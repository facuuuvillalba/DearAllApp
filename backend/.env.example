PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comapp
DB_SSL=false

# JWT (mínimo 32 caracteres; generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=12h

# Orígenes web permitidos (separados por coma): panel admin y Expo web (dev). Las apps nativas no envían Origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Usuario administrador inicial (npm run seed:admin)
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=CambiarEsto123
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Sistema
